# Copie este archivo como .streamlit/secrets.toml (ejecución local) o pegue su contenido en
# Streamlit Community Cloud → App settings → Secrets. Nunca lo suba a GitHub con valores reales.
QDRANT_URL = "https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io"
QDRANT_API_KEY = "pegue-aqui-la-api-key-del-cluster"
OPENAI_API_KEY = "pegue-aqui-su-clave-de-openai"
ADMIN_PASSWORD = "una-clave-para-cargar-o-retirar-documentos"
# Opcionales
# GROQ_API_KEY = "..."
# GEMINI_API_KEY = "..."
# EMBEDDINGS = "openai"   # usa el índice paralelo de OpenAI en lugar de E5 (menos memoria)
